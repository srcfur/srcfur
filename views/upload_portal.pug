extends layout

block content
    script(type="module" src="/javascripts/upload_backend.js")
    link(rel='stylesheet', href='/stylesheets/back_portal.css')
    form(id="UploadForm" action="/api/gallery/upload" method="post" enctype="multipart/form-data")
        h1(class="labeled") Post Title
        input(type="text" name="title")
        h1(class="labeled") Post Description
        textarea(name="description")
        select(name="rating")
            option(value=1) Safe
            option(value=2) Questionable
            option(value=3) Explicit
        h1(class="labeled") Tags
        textarea(name="tags")
        h1(class="labeled") Versions
        input(type="number" name="imagecount" value="1" min="1" max="9" style="width: 25%;min-width:2rem;font-size:1rem;")
        #fileArea
        h1(class="labeled") Furaffinity
        .subBox
            select(name="cat")
                optgroup(label="Specialty")
                    option(value=1) All
                    option(value=2) Digital Art
                    option(value=37) 2D animation
                    option(value=38) 3D animation
                    option(value=39) Pixel Animation
            select(name="theme")
                optgroup(label="Specialty")
                    option(value=100) General Furry Art
                    option(value=122) ABDL
                    option(value=101) Babyfur
                    option(value=121) Hypnosis
                    option(value=120) TF
                    option(value=118) Watersports
        h1(class="labeled") Destinations
        #destinationArea
        input(type="submit" id="SubmitForm")