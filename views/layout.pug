doctype html

include universalelments

html
  head
    title="Srcfur - " + title
    link(rel='stylesheet', href='/stylesheets/style.css')
    script(src="/javascripts/API.js")
  body
    #navBar
      .header
        h1 Srcfur's Gay Lil Puppy Pound
        h2=title
      div
        .nbc
          a(href="/gallery", class="easyCenter")
            h1 Gallery
      div
        .nbc
          a(href="https://web.canary.fluxer.app/oauth2/authorize?client_id=1552111823480696833&scope=identify+email&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fapi%2Fauthorize&response_type=code")
            h1 Login
      .fluxerViewingAs
        .nbc
          p Viewing as:
          +fluxerpanel("local")
    block content
    script(type="module").
      function OnLoaded(){
        console.log("UwU")
        let fluxerpanels = document.getElementsByClassName("fluxerpanel")
        for (let i = 0; i < fluxerpanels.length; i++) {
          let panel = fluxerpanels[i];
          GetAccount().then((account)=>{
            if(account == 401){
              panel.children[1].removeChild(panel.children[1].children[0]);
              let loginlink = document.createElement("a")
              loginlink.innerText = "Login with Fluxer"
              loginlink.href="https://web.canary.fluxer.app/oauth2/authorize?client_id=1552111823480696833&scope=identify+email&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fapi%2Fauthorize&response_type=code"
              panel.children[1].appendChild(loginlink);
              return;
            }
            panel.children[0].children[0].src = "https://fluxerusercontent.com/avatars/" + account.id + "/" + account.avatar + ".webp?size=128"
            panel.children[1].children[0].innerHTML = account.global_name;
          })
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', OnLoaded);
      } else {
        OnLoaded(); // DOM already ready, run immediately
      }