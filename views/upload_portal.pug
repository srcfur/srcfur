extends layout

block content
    script(type="module" src="/javascripts/upload_backend.js")
    link(rel='stylesheet', href='/stylesheets/back_portal.css')
    form(id="UploadForm" action="/api/gallery/upload" method="post" enctype="multipart/form-data")
        h1(class="labeled") Post Title
        input(type="text" name="title")
        h1(class="labeled") Post Description
        textarea(name="description")
        h1(class="labeled") Tags
        textarea(name="tags")
        h1(class="labeled") Versions
        input(type="number" name="imagecount" value="1" min="1" max="9" style="width: 25%;min-width:2rem;font-size:1rem;")
        #fileArea
        h1(class="labeled") Destinations
        #destinationArea
        input(type="submit" id="SubmitForm")